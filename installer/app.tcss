/* Sized for a phone screen driven by touch: full-width targets, generous
   height, nothing that needs a precise tap. */

Screen {
    background: $surface;
}

#menu {
    padding: 1 2;
    align: center top;
}

/* Button rows, used by the menu and by screens with several actions.
   grid-gutter is 2, not 1: a destructive button (Remove, Reset) often sits
   right next to a safe one, and a single-cell gap is thin enough on a
   touch screen that a mistap lands on the neighbour instead. */
.row1,
.row2,
.row3 {
    width: 100%;
    height: auto;
    grid-rows: 3;
    grid-gutter: 2;
    margin-bottom: 1;
}

.row1 { grid-size: 1; }
.row2 { grid-size: 2; }
.row3 { grid-size: 3; }

.row1 Button,
.row2 Button,
.row3 Button {
    width: 100%;
    height: 3;
}

/* Outside #menu the rows sit against the screen edge, so they need the same
   side margin the tables and buttons use. */
Screen > .row2,
Screen > .row3 {
    margin: 0 2 1 2;
}

.screen-title {
    width: 100%;
    padding: 1 2;
    text-style: bold;
    color: $text;
    background: $panel;
}

#log {
    height: 1fr;
    margin: 1 2;
    padding: 1;
    border: round $primary;
    background: $surface-darken-1;
}

#status-table,
#doctor-table,
#dupes-table {
    height: 1fr;
    margin: 1 2;
}

#dupes-note {
    margin: 1 2 0 2;
    padding: 1;
    border: round $primary;
}

#doctor-buttons {
    width: 100%;
    height: auto;
    margin: 0 2 0 2;
}

#action-buttons {
    width: 100%;
    height: auto;
    margin: 0 2 1 2;
}

#doctor-buttons Button,
#action-buttons Button {
    width: 1fr;
    height: 3;
    margin-right: 1;
}

/* The copy button is a single letter, so it does not need an equal share. */
#doctor-buttons Button#copy,
#action-buttons Button#copy {
    width: 7;
}

/* The Back button on every sub-screen. */
Screen > Button#back {
    width: 100%;
    height: 3;
    margin: 0 2 1 2;
}

/* Confirmation modal */
ConfirmScreen {
    align: center middle;
    background: $background 60%;
}

#dialog {
    width: 90%;
    max-width: 60;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: thick $error;
    background: $surface;
}

#dialog-title {
    width: 100%;
    text-style: bold;
    color: $error;
    margin-bottom: 1;
}

#dialog-body {
    width: 100%;
    margin-bottom: 1;
}

#dialog-buttons {
    width: 100%;
    height: auto;
    align: center middle;
}

#dialog-buttons Button {
    width: 1fr;
    height: 3;
    margin: 0 1;
}

/* Store */
#query {
    margin: 1 2 0 2;
}

#store-status,
#doctor-info {
    margin: 0 2;
    padding: 0 1;
    color: $text-muted;
}

#store-table {
    height: 1fr;
    margin: 1 2;
}

/* Live progress from a downloader, redrawn in place above the buttons. */
#progress {
    height: auto;
    margin: 0 2;
    padding: 0 1;
    color: $success;
}

/* Add Repository form */
#add-repo-note {
    margin: 1 2 0 2;
    padding: 1;
    border: round $primary;
}

#add-repo-status {
    margin: 0 2;
    padding: 0 1;
    color: $error;
    height: auto;
}

AddRepoScreen Label {
    margin: 1 2 0 2;
}

AddRepoScreen Input {
    margin: 0 2;
}

#add-repo-form {
    height: 1fr;
}

/* Manual Install form */
#manual-install-note {
    margin: 1 2 0 2;
    padding: 1;
    border: round $primary;
}

#manual-install-status {
    margin: 0 2;
    padding: 0 1;
    color: $error;
    height: auto;
}

ManualInstallScreen Label {
    margin: 1 2 0 2;
}

ManualInstallScreen Input {
    margin: 0 2;
}

ManualInstallScreen Grid.row3 {
    margin: 1 2 0 2;
}

#manual-install-form {
    height: 1fr;
}

/* Settings form */
#settings-form {
    height: 1fr;
}

#settings-note {
    margin: 1 2 0 2;
    padding: 1;
    border: round $primary;
}

#settings-mirror,
#settings-status {
    margin: 0 2;
    padding: 0 1;
    color: $text-muted;
}

SettingsScreen Label {
    margin: 1 2 0 2;
}

SettingsScreen Select {
    margin: 0 2;
}
